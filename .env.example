# Copy to .env and fill in. Never commit .env.

# Coolify - Keys & Tokens -> API tokens (enable API in Settings first)
COOLIFY_URL=https://coolify.yourdomain.com
COOLIFY_API_TOKEN=

# n8n (from Coolify) - Settings -> n8n API
N8N_URL=https://n8n.yourdomain.com
N8N_API_KEY=

# Postgres for research data (separate DB + user, not the n8n internal DB)
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=niche_research
POSTGRES_USER=research
POSTGRES_PASSWORD=

# Phase 1: Reddit - https://www.reddit.com/prefs/apps (type: script)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=niche-research/0.1 by your_reddit_username

# AI
ANTHROPIC_API_KEY=

# Phase 2: Pinterest (later)
PINTEREST_ACCESS_TOKEN=

# Phase 3: Etsy (later) - https://www.etsy.com/developers
ETSY_API_KEY=
